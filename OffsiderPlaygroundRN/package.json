{
  "name": "offsiderplaygroundrn",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.33",
    "expo-build-properties": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 NODE_OPTIONS=--dns-result-order=ipv4first expo start --port 8742 --localhost",
    "android": "../scripts/rn-playground.sh dev-android",
    "ios": "../scripts/rn-playground.sh dev-ios",
    "prebuild": "EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 COCOAPODS_DISABLE_STATS=true expo prebuild --clean",
    "android:release": "../scripts/rn-playground.sh build-android",
    "ios:release": "../scripts/rn-playground.sh build-ios",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
