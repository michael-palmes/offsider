# Copy to .env (git-ignored) and fill in the values for your machine.
# Load it into your shell with: set -a; . ./.env; set +a
OFFSIDER_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
OFFSIDER_NOTARY_KEY_PATH=./keys/AuthKey_XXXX.p8
OFFSIDER_NOTARY_KEY_ID=
OFFSIDER_NOTARY_ISSUER_ID=
# Apple development team that signs the iPhone runner (Xcode > Settings > Accounts); optional with one team signed in.
OFFSIDER_IOS_TEAM_ID=
