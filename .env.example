# Copy to .env (git-ignored) and fill in only what you need. test-runner.sh loads it itself;
# for scripts/release.sh, load it into your shell first: set -a; . ./.env; set +a
OFFSIDER_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# The Apple team that signs releases; scripts/release.sh verifies TeamIdentifier against it (not needed with --adhoc).
TEAM_ID=
OFFSIDER_NOTARY_KEY_PATH=./keys/AuthKey_XXXX.p8
OFFSIDER_NOTARY_KEY_ID=
OFFSIDER_NOTARY_ISSUER_ID=
# Apple team that signs the iPhone runner and playground. Leave it empty to use the team you chose in
# `offsider device-access allow`; Xcode's signed-in team is never picked on its own.
OFFSIDER_IOS_TEAM_ID=
# Only when your E2E simulator or AVDs have other names (defaults: a stock iPhone, Offsider Duo, Offsider_E2E,
# Offsider_E2E_Fold; scripts/e2e-devices.sh creates the default ones).
OFFSIDER_SIMULATOR_NAME=
OFFSIDER_FOLDABLE_SIMULATOR_NAME=
OFFSIDER_ANDROID_E2E_AVD=
OFFSIDER_ANDROID_FOLD_AVD=
